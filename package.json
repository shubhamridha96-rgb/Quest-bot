{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "Questy — Sadie Sink Edition",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start":       "npm run build:web && node --loader ts-node/esm --max-old-space-size=4096 src/index.ts",
    "dev":         "node --loader ts-node/esm --max-old-space-size=4096 --watch src/index.ts",
    "dev:web":     "cd questy_-discord-quest-automation && npm install --prefer-offline && npm run dev",
    "build":       "tsc",
    "build:web":   "cd questy_-discord-quest-automation && npm install && npm run build",
    "build:all":   "npm run build && npm run build:web",
    "test":        "node --loader ts-node/esm src/test/deployment.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@logtail/node": "^0.5.5",
    "@logtail/winston": "^0.5.5",
    "@types/convert-units": "^2.3.12",
    "@types/express-session": "^1.18.1",
    "@types/nunjucks": "^3.2.6",
    "axios": "^1.8.2",
    "canvas": "^3.1.0",
    "chalk": "^5.4.1",
    "concurrently": "^7.6.0",
    "discord.js": "^14.22.1",
    "discord.js-selfbot-v13": "^3.7.0",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "fluent-ffmpeg": "^2.1.3",
    "humanize-duration": "^3.32.1",
    "ini": "^5.0.0",
    "moment-timezone": "^0.5.47",
    "mongodb": "^6.17.0",
    "mongoose": "^8.16.5",
    "ms": "^2.1.3",
    "mysql": "^2.18.1",
    "node-cron": "^4.2.1",
    "node-schedule": "^2.1.1",
    "numeral": "^2.0.6",
    "nunjucks": "^3.2.4",
    "pidusage": "^4.0.1",
    "proxy-agent": "^6.5.0",
    "sharp": "^0.34.4",
    "sqlite3": "^5.1.7",
    "ts-node": "^10.9.1",
    "typeorm": "^0.3.25",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/socket.io-client": "^1.4.36",
    "nodemon": "^3.0.0",
    "typescript": "^5.9.2"
  }
}
